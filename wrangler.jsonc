{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selfpay",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  // Static site from dist/. Only /api/* runs the Worker; everything else is served straight from the assets.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Wallet sign-ins, sessions and saved plans. Schema: schema.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selfpay",
      "database_id": "fe66608d-728c-4819-9ae8-caf771787481"
    }
  ]
}
